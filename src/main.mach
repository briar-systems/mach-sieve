use std.runtime;

use std.allocator;
use std.allocator.page;
use std.chrono.duration.Duration;
use std.chrono.duration.duration_msec;
use std.chrono.time;
use std.collections.vector;
use std.collections.vector.Vector;
use std.memory;
use std.print.printf;
use std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

tag SieveError: u8 {
    limit_too_small;
    null_buffer;
    buffer_too_small;
}

# mark prime indices below limit in the primes buffer
fun sieve(limit: u64, primes: *bool, count: usize) err[SieveError] {
    if (limit < 2) {
        ret err[SieveError].err{SieveError.limit_too_small{}};
    }

    if (primes == nil) {
        ret err[SieveError].err{SieveError.null_buffer{}};
    }

    if (count < limit::usize) {
        ret err[SieveError].err{SieveError.buffer_too_small{}};
    }

    # assume all numbers are prime initially
    memory.fill[bool](primes, true, count);
    primes[0] = false;
    primes[1] = false;

    # mark even numbers above two
    var i: u64 = 4;
    for (i < limit) {
        primes[i::usize] = false;
        i                = i + 2;
    }

    # sieve odd composites
    var p: u64 = 3;
    for (p * p < limit) {
        if (primes[p::usize]) {
            var j: u64 = p * p;
            for (j < limit) {
                primes[j::usize] = false;
                j                = j + p;
            }
        }
        p = p + 2;
    }

    ret err[SieveError].ok{};
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var limit: u64 = 100000000;
    printf("usage: {} [limit] (default: {})\n", argv[0], limit);

    if (argc > 1) {
        val r: res[u64, parse.ParseError] = parse.parse_u64(argv[1], 10);
        if (sel r.err) {
            if (sel r.err.empty) {
                printf("error: invalid limit: empty input\n");
            }
            if (sel r.err.syntax) {
                printf("error: invalid limit: invalid syntax\n");
            }
            if (sel r.err.overflow) {
                printf("error: invalid limit: number overflow\n");
            }
            if (sel r.err.base) {
                printf("error: invalid limit: invalid base\n");
            }
            ret 1;
        }
        limit = r.ok;
    }

    printf("finding primes up to {}\n", limit);

    val count: usize = limit::usize;
    if ((count::u64) != limit) {
        printf("error: limit is too large for this platform\n");
        ret 1;
    }

    # initialize a page-backed allocator
    var a:        allocator.Allocator;
    val opt_make: err[allocator.Error] = page.make(?a);
    if (sel opt_make.err) {
        printf("error: failed to initialize page allocator\n");
        ret 1;
    }

    # allocate memory for the sieve
    val r_alloc: res[*bool, allocator.Error] = allocator.allocate[bool](?a, count);
    if (sel r_alloc.err) {
        printf("error: failed to allocate sieve buffer\n");
        ret 1;
    }

    val primes: *bool = r_alloc.ok;

    # run the sieve
    val start_res: time.Clock = time.now();
    if (sel start_res.err) {
        printf("error: failed to read start time\n");
        ret 1;
    }
    val start: time.Time = start_res.ok;

    val opt_err: err[SieveError] = sieve(limit, primes, count);
    if (sel opt_err.err) {
        if (sel opt_err.err.limit_too_small) {
            printf("error: limit must be at least 2\n");
        }
        if (sel opt_err.err.null_buffer) {
            printf("error: provided buffer has null data pointer\n");
        }
        if (sel opt_err.err.buffer_too_small) {
            printf("error: provided buffer is smaller than required\n");
        }
        ret 1;
    }

    val el_res: time.Elapsed = time.since(start);
    if (sel el_res.err) {
        printf("error: failed to read elapsed time\n");
        ret 1;
    }
    val elapsed: Duration = el_res.ok;

    # collect prime indices
    var indices: Vector[u64] = vector.init[u64](?a);
    var idx:     u64         = 0;
    for (idx < limit) {
        if (primes[idx::usize]) {
            val r_push: res[usize, allocator.Error] = vector.push[u64](?indices, idx);
            if (sel r_push.err) {
                printf("error: failed to push prime index\n");
                ret 1;
            }
        }
        idx = idx + 1;
    }

    printf("found:       {}\n", indices.len);
    printf("time taken:  {} ms\n", duration_msec(elapsed));

    if (indices.len > 0) {
        printf("first prime: {}\n", indices.data[0]);
        printf("last prime:  {}\n", indices.data[indices.len - 1]);
    }

    # cleanup
    vector.dnit[u64](?indices);
    allocator.deallocate[bool](?a, primes, count);

    ret 0;
}

test "sieve: basic prime generation" {
    var a:        allocator.Allocator;
    val opt_make: err[allocator.Error] = page.make(?a);
    if (sel opt_make.err) { ret 1; }

    val limit:   u64                         = 10;
    val count:   usize                       = limit::usize;
    val r_alloc: res[*bool, allocator.Error] = allocator.allocate[bool](?a, count);
    if (sel r_alloc.err) { ret 2; }
    val primes: *bool = r_alloc.ok;

    val opt_err: err[SieveError] = sieve(limit, primes, count);
    if (sel opt_err.err) { ret 3; }

    if (primes[0] || primes[1])                               { ret 4; }
    if (!primes[2] || !primes[3] || !primes[5] || !primes[7]) { ret 5; }
    if (primes[4] || primes[6] || primes[8] || primes[9])     { ret 6; }

    allocator.deallocate[bool](?a, primes, count);
    ret 0;
}

test "sieve: invalid limit returns error" {
    val opt_err: err[SieveError] = sieve(1, nil, 0);
    if (sel opt_err.ok)                   { ret 1; }
    if (!sel opt_err.err.limit_too_small) { ret 2; }
    ret 0;
}

test "sieve: nil primes buffer returns error" {
    val opt_err: err[SieveError] = sieve(10, nil, 10);
    if (sel opt_err.ok)               { ret 1; }
    if (!sel opt_err.err.null_buffer) { ret 2; }
    ret 0;
}

test "sieve: small buffer returns error" {
    var a:        allocator.Allocator;
    val opt_make: err[allocator.Error] = page.make(?a);
    if (sel opt_make.err) { ret 1; }

    val r_alloc: res[*bool, allocator.Error] = allocator.allocate[bool](?a, 5);
    if (sel r_alloc.err) { ret 2; }
    val primes: *bool = r_alloc.ok;

    val opt_err: err[SieveError] = sieve(10, primes, 5);
    allocator.deallocate[bool](?a, primes, 5);

    if (sel opt_err.ok)                    { ret 3; }
    if (!sel opt_err.err.buffer_too_small) { ret 4; }
    ret 0;
}
